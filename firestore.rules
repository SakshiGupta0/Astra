rules_version = '2';
// ASTRA: every user can read and write only their own documents. Usage counters are written by the server only.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /usage/{day} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /{coll}/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid && coll != "usage";
      }
    }
    match /usage/{day} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
